-- =====================================================
-- DATABASE CONFIGURATION & EXTENSIONS
-- =====================================================
-- Automatically updates the updated_at timestamp field on row updates
CREATE OR REPLACE FUNCTION update_modified_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = now();
    RETURN NEW;
END;
$$ language 'plpgsql';

-- =====================================================
-- 1. USERS & ACCESS CONTROL
-- =====================================================
CREATE TABLE IF NOT EXISTS teams (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT UNIQUE NOT NULL,
  phone TEXT UNIQUE,
  password TEXT NOT NULL,
  role TEXT DEFAULT 'support' CHECK (role IN ('support', 'manager', 'developer')),
  is_active BOOLEAN DEFAULT TRUE,
  is_verified BOOLEAN DEFAULT FALSE,
  reset_token TEXT,
  token_expires_at TIMESTAMP,
  verification_token TEXT,
  verification_expires_at TIMESTAMP,
  is_2fa_active BOOLEAN DEFAULT FALSE,
  two_fa_verification_token TEXT,
  two_fa_verification_expires_at TIMESTAMP,
  pending_email TEXT,
  email_change_code TEXT,
  email_change_expires_at TIMESTAMP,
  city TEXT,
  country TEXT,
  address_line1 TEXT,
  address_line2 TEXT,
  state TEXT,
  postal_code TEXT,
  last_login TIMESTAMP,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE TRIGGER update_teams_modtime 
BEFORE UPDATE ON teams 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();

CREATE INDEX idx_teams_email ON teams(email);
CREATE INDEX idx_teams_role ON teams(role);
CREATE INDEX idx_teams_is_active ON teams(is_active);

CREATE TABLE IF NOT EXISTS users (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT UNIQUE NOT NULL,
  phone TEXT UNIQUE,
  password TEXT NOT NULL,
  is_active BOOLEAN DEFAULT TRUE,
  is_verified BOOLEAN DEFAULT FALSE,
  reset_token TEXT,
  token_expires_at TIMESTAMP,
  verification_token TEXT,
  verification_expires_at TIMESTAMP,
  is_2fa_active BOOLEAN DEFAULT FALSE,
  two_fa_verification_token TEXT,
  two_fa_verification_expires_at TIMESTAMP,
  pending_email TEXT,
  email_change_code TEXT,
  email_change_expires_at TIMESTAMP,
  city TEXT,
  country TEXT,
  address_line1 TEXT,
  address_line2 TEXT,
  state TEXT,
  postal_code TEXT,
  last_login TIMESTAMP,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE TRIGGER update_users_modtime 
BEFORE UPDATE ON users 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();

CREATE INDEX idx_users_email ON users(email);
CREATE INDEX idx_users_is_active ON users(is_active);

-- =====================================================
-- 2. PRODUCTS & FEATURES
-- =====================================================
CREATE TABLE IF NOT EXISTS products (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  description TEXT,
  demo_url TEXT,
  is_featured BOOLEAN DEFAULT TRUE,
  is_published BOOLEAN DEFAULT TRUE,
  created_by INT REFERENCES teams(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE TRIGGER update_products_modtime 
BEFORE UPDATE ON products 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();

CREATE INDEX idx_products_slug ON products(slug);
CREATE INDEX idx_products_created_by ON products(created_by);
CREATE INDEX idx_products_is_featured ON products(is_featured);
CREATE INDEX idx_products_is_published ON products(is_published);

CREATE TABLE IF NOT EXISTS product_images (
  id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
  image TEXT NOT NULL,
  public_id TEXT NOT NULL,
  product_id INT REFERENCES products(id) ON DELETE CASCADE,
  is_primary BOOLEAN DEFAULT FALSE, 
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_product_images_product_id ON product_images(product_id);
CREATE INDEX idx_product_images_is_primary ON product_images(product_id, is_primary);

CREATE TABLE IF NOT EXISTS features (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  description TEXT
);

CREATE INDEX idx_features_name ON features(name);
CREATE INDEX idx_features_slug ON features(slug);

CREATE TABLE IF NOT EXISTS product_features (
  id SERIAL PRIMARY KEY,
  product_id INT REFERENCES products(id) ON DELETE CASCADE,
  feature_id INT REFERENCES features(id) ON DELETE CASCADE,
  value BOOLEAN DEFAULT TRUE,
  UNIQUE(product_id, feature_id)
);

CREATE INDEX idx_product_features_product_id ON product_features(product_id);
CREATE INDEX idx_product_features_feature_id ON product_features(feature_id);

-- =====================================================
-- 3. INTERNAL MESSAGING SYSTEM
-- =====================================================
CREATE TABLE IF NOT EXISTS chats (
  id SERIAL PRIMARY KEY,
  title TEXT,
  is_group BOOLEAN DEFAULT FALSE,
  created_by INT REFERENCES teams(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_chats_created_by ON chats(created_by);

CREATE TABLE IF NOT EXISTS chat_participants (
  id SERIAL PRIMARY KEY,
  chat_id INT REFERENCES chats(id) ON DELETE CASCADE,
  team_id INT REFERENCES teams(id) ON DELETE CASCADE,
  last_read_at TIMESTAMP,
  joined_at TIMESTAMP DEFAULT now(),
  UNIQUE(chat_id, team_id)
);

CREATE INDEX idx_chat_participants_chat_id ON chat_participants(chat_id);
CREATE INDEX idx_chat_participants_team_id ON chat_participants(team_id);

CREATE TABLE IF NOT EXISTS chat_messages (
  id SERIAL PRIMARY KEY,
  chat_id INT REFERENCES chats(id) ON DELETE CASCADE,
  sender_id INT REFERENCES teams(id) ON DELETE SET NULL,
  content TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_chat_messages_chat_id ON chat_messages(chat_id);
CREATE INDEX idx_chat_messages_sender_id ON chat_messages(sender_id);
CREATE INDEX idx_chat_messages_created_at ON chat_messages(chat_id, created_at);

CREATE TABLE IF NOT EXISTS chat_attachments (
  id SERIAL PRIMARY KEY,
  chat_id INT REFERENCES chats(id) ON DELETE CASCADE,
  sender_id INT REFERENCES teams(id) ON DELETE CASCADE,
  image TEXT NOT NULL,
  image_id TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_chat_attachments_chat_id ON chat_attachments(chat_id);
CREATE INDEX idx_chat_attachments_sender_id ON chat_attachments(sender_id);

-- =====================================================
-- 4. SUPPORT & TICKET SYSTEMS
-- =====================================================
CREATE TABLE IF NOT EXISTS supports (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT NOT NULL,
  subject TEXT NOT NULL,
  description TEXT NOT NULL,
  reply TEXT,                 
  status TEXT DEFAULT 'pending' CHECK(status IN ('pending', 'replied')),
  responded_by INT REFERENCES teams(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE TRIGGER update_supports_modtime 
BEFORE UPDATE ON supports 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();

CREATE INDEX idx_supports_email ON supports(email);
CREATE INDEX idx_supports_status ON supports(status);
CREATE INDEX idx_supports_responded_by ON supports(responded_by);

CREATE TABLE IF NOT EXISTS tickets (
  id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
  created_by INT REFERENCES teams(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE TRIGGER update_tickets_modtime 
BEFORE UPDATE ON tickets 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();

CREATE INDEX idx_tickets_created_by ON tickets(created_by);

CREATE TABLE IF NOT EXISTS ticket_participants (
  id SERIAL PRIMARY KEY,
  ticket_id INT REFERENCES tickets(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE CASCADE,
  team_id INT REFERENCES teams(id) ON DELETE CASCADE,
  CHECK (
    (user_id IS NOT NULL AND team_id IS NULL)
    OR
    (user_id IS NULL AND team_id IS NOT NULL)
  ),
  last_read_at TIMESTAMP,
  joined_at TIMESTAMP DEFAULT now(),
  UNIQUE(ticket_id, user_id, team_id)
);

CREATE INDEX idx_ticket_participants_ticket_id ON ticket_participants(ticket_id);
CREATE INDEX idx_ticket_participants_user_id ON ticket_participants(user_id);
CREATE INDEX idx_ticket_participants_team_id ON ticket_participants(team_id);

CREATE TABLE IF NOT EXISTS ticket_messages (
  id SERIAL PRIMARY KEY,
  ticket_id INT REFERENCES tickets(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE SET NULL,
  team_id INT REFERENCES teams(id) ON DELETE SET NULL,
  CHECK (
    (user_id IS NOT NULL AND team_id IS NULL)
    OR
    (user_id IS NULL AND team_id IS NOT NULL)
  ),
  message TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_ticket_messages_ticket_id ON ticket_messages(ticket_id);
CREATE INDEX idx_ticket_messages_user_id ON ticket_messages(user_id);
CREATE INDEX idx_ticket_messages_team_id ON ticket_messages(team_id);
CREATE INDEX idx_ticket_messages_created_at ON ticket_messages(ticket_id, created_at);

CREATE TABLE IF NOT EXISTS ticket_attachments (
  id SERIAL PRIMARY KEY,
  ticket_id INT REFERENCES tickets(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE SET NULL,
  team_id INT REFERENCES teams(id) ON DELETE SET NULL,
  CHECK (
    (user_id IS NOT NULL AND team_id IS NULL)
    OR
    (user_id IS NULL AND team_id IS NOT NULL)
  ),
  file_url TEXT NOT NULL,
  file_id TEXT,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_ticket_attachments_ticket_id ON ticket_attachments(ticket_id);
CREATE INDEX idx_ticket_attachments_user_id ON ticket_attachments(user_id);
CREATE INDEX idx_ticket_attachments_team_id ON ticket_attachments(team_id);

-- =====================================================
-- 5. COMPANY, CAREERS & BOARDS
-- =====================================================
CREATE TABLE IF NOT EXISTS boards (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  post TEXT NOT NULL,
  email TEXT UNIQUE,
  image TEXT,
  image_id TEXT,
  bio TEXT,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_boards_email ON boards(email);

CREATE TABLE IF NOT EXISTS careers (
  job_id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
  location TEXT NOT NULL,
  job_type TEXT NOT NULL, 
  level TEXT NOT NULL, 
  compensation TEXT,
  description TEXT NOT NULL,
  responsibilities TEXT[],
  skills TEXT[],
  nice_to_have TEXT[],
  is_published BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_careers_is_published ON careers(is_published);
CREATE INDEX idx_careers_job_type ON careers(job_type);

CREATE TABLE IF NOT EXISTS career_applications (
  app_id SERIAL PRIMARY KEY,
  job_id INT REFERENCES careers(job_id) ON DELETE CASCADE,
  full_name TEXT NOT NULL,
  email TEXT NOT NULL,
  resume_url TEXT NOT NULL,
  cover_letter TEXT,
  status TEXT DEFAULT 'applied' CHECK (status IN ('applied', 'interviewing', 'rejected', 'hired')),
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_career_applications_job_id ON career_applications(job_id);
CREATE INDEX idx_career_applications_status ON career_applications(status);

-- =====================================================
-- 6. REVIEWS, NOTIFICATIONS & LOGS
-- =====================================================
CREATE TABLE IF NOT EXISTS reviews (
  id SERIAL PRIMARY KEY,
  user_id INT REFERENCES users(id) ON DELETE CASCADE UNIQUE,
  rating INT CHECK (rating BETWEEN 1 AND 5),
  comment TEXT,
  reply TEXT,
  is_approved BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_reviews_user_id ON reviews(user_id);
CREATE INDEX idx_reviews_is_approved ON reviews(is_approved);

CREATE TABLE IF NOT EXISTS notifications (
  id SERIAL PRIMARY KEY,
  user_id INT REFERENCES users(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  message TEXT NOT NULL,
  link TEXT,
  is_read BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_notifications_user_id ON notifications(user_id);
CREATE INDEX idx_notifications_is_read ON notifications(user_id, is_read);

CREATE TABLE IF NOT EXISTS activity_logs (
  id SERIAL PRIMARY KEY,
  team_id INT REFERENCES teams(id) ON DELETE SET NULL,
  action TEXT NOT NULL,
  entity_type TEXT,
  entity_id INT,
  description TEXT,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_activity_logs_team_id ON activity_logs(team_id);
CREATE INDEX idx_activity_logs_entity ON activity_logs(entity_type, entity_id);

CREATE TABLE IF NOT EXISTS team_login_logs (
  id SERIAL PRIMARY KEY,
  team_id INT REFERENCES teams(id) ON DELETE SET NULL,
  action TEXT NOT NULL,
  entity_type TEXT,
  entity_id INT,
  description TEXT,
  status TEXT DEFAULT 'success' CHECK(status IN ('success','fail')),
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_team_login_logs_team_id ON team_login_logs(team_id);

CREATE TABLE IF NOT EXISTS user_login_logs (
  id SERIAL PRIMARY KEY,
  user_id INT REFERENCES users(id) ON DELETE SET NULL,
  action TEXT NOT NULL,
  entity_type TEXT,
  entity_id INT,
  description TEXT,
  status TEXT DEFAULT 'success' CHECK(status IN ('success','fail')),
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_user_login_logs_user_id ON user_login_logs(user_id);

-- =====================================================
-- 7. PARTNERS & LEADS
-- =====================================================
CREATE TABLE IF NOT EXISTS partners (
  id SERIAL PRIMARY KEY,
  company_name TEXT UNIQUE NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  business_url TEXT NOT NULL, 
  image TEXT NOT NULL,
  image_id TEXT NOT NULL,
  email TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_partners_slug ON partners(slug);

CREATE TABLE IF NOT EXISTS business_leads (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT NOT NULL,
  phone TEXT,
  address TEXT,
  note TEXT,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_business_leads_email ON business_leads(email);

CREATE TABLE IF NOT EXISTS client_leads (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT NOT NULL,
  phone TEXT,
  address TEXT,
  note TEXT,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_client_leads_email ON client_leads(email);

-- =====================================================
-- 8. PROJECTS & PURCHASES
-- =====================================================
CREATE TABLE IF NOT EXISTS projects (
  id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
  product_id INT REFERENCES products(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE CASCADE,
  team_id INT REFERENCES teams(id) ON DELETE CASCADE,
  CHECK (
    (user_id IS NOT NULL AND team_id IS NULL)
    OR
    (user_id IS NULL AND team_id IS NOT NULL)
  ),
  status TEXT DEFAULT 'pending' CHECK(status IN ('pending','working','ready','ontest','fixing', 'approved')),
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE TRIGGER update_projects_modtime 
BEFORE UPDATE ON projects 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();

CREATE INDEX idx_projects_product_id ON projects(product_id);
CREATE INDEX idx_projects_user_id ON projects(user_id);
CREATE INDEX idx_projects_team_id ON projects(team_id);
CREATE INDEX idx_projects_status ON projects(status);

CREATE TABLE IF NOT EXISTS project_participants (
  id SERIAL PRIMARY KEY,
  project_id INT REFERENCES projects(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE CASCADE,
  team_id INT REFERENCES teams(id) ON DELETE CASCADE,
  CHECK (
    (user_id IS NOT NULL AND team_id IS NULL)
    OR
    (user_id IS NULL AND team_id IS NOT NULL)
  ),
  last_read_at TIMESTAMP,
  joined_at TIMESTAMP DEFAULT now(),
  UNIQUE(project_id, user_id, team_id)
);

CREATE INDEX idx_project_participants_project_id ON project_participants(project_id);
CREATE INDEX idx_project_participants_user_id ON project_participants(user_id);
CREATE INDEX idx_project_participants_team_id ON project_participants(team_id);

CREATE TABLE IF NOT EXISTS project_messages (
  id SERIAL PRIMARY KEY,
  project_id INT REFERENCES projects(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE SET NULL,
  team_id INT REFERENCES teams(id) ON DELETE SET NULL,
  CHECK (
    (user_id IS NOT NULL AND team_id IS NULL)
    OR
    (user_id IS NULL AND team_id IS NOT NULL)
  ),
  message TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_project_messages_project_id ON project_messages(project_id);
CREATE INDEX idx_project_messages_user_id ON project_messages(user_id);
CREATE INDEX idx_project_messages_team_id ON project_messages(team_id);
CREATE INDEX idx_project_messages_created_at ON project_messages(project_id, created_at);

CREATE TABLE IF NOT EXISTS project_attachments (
  id SERIAL PRIMARY KEY,
  project_id INT REFERENCES projects(id) ON DELETE CASCADE,
  user_id INT REFERENCES users(id) ON DELETE SET NULL,
  team_id INT REFERENCES teams(id) ON DELETE SET NULL,
  CHECK (
    (user_id IS NOT NULL AND team_id IS NULL)
    OR
    (user_id IS NULL AND team_id IS NOT NULL)
  ),
  file_url TEXT NOT NULL,
  file_id TEXT,
  created_at TIMESTAMP DEFAULT now()
);

CREATE INDEX idx_project_attachments_project_id ON project_attachments(project_id);
CREATE INDEX idx_project_attachments_user_id ON project_attachments(user_id);
CREATE INDEX idx_project_attachments_team_id ON project_attachments(team_id);

CREATE TABLE IF NOT EXISTS purchases (
  id SERIAL PRIMARY KEY,
  product_id INT REFERENCES products(id) ON DELETE CASCADE,
  project_id INT REFERENCES projects(id) ON DELETE CASCADE,
  price INT NOT NULL,
  discount INT DEFAULT 0,
  status TEXT DEFAULT 'incomplete' CHECK (status IN ('incomplete','complete')),
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE TRIGGER update_purchases_modtime 
BEFORE UPDATE ON purchases 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();

CREATE INDEX idx_purchases_product_id ON purchases(product_id);
CREATE INDEX idx_purchases_project_id ON purchases(project_id);
CREATE INDEX idx_purchases_status ON purchases(status);

CREATE TABLE IF NOT EXISTS payments (
  id SERIAL PRIMARY KEY,
  purchase_id INT NOT NULL REFERENCES purchases(id) ON DELETE CASCADE,
  price INT NOT NULL,
  paid INT DEFAULT 0,
  due INT DEFAULT 0,
  status TEXT DEFAULT 'unpaid' CHECK (status IN ('unpaid','due','paid')),
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE TRIGGER update_payments_modtime 
BEFORE UPDATE ON payments 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();

CREATE INDEX idx_payments_purchase_id ON payments(purchase_id);
CREATE INDEX idx_payments_status ON payments(status);

-- =====================================================
-- 9. NEWSLETTERS
-- =====================================================
CREATE TABLE IF NOT EXISTS news_letters (
  id SERIAL PRIMARY KEY,
  subject TEXT NOT NULL,
  description TEXT,
  image TEXT NOT NULL,
  image_id TEXT NOT NULL,
  created_by INT REFERENCES teams(id) ON DELETE CASCADE,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);

CREATE TRIGGER update_news_letters_modtime 
BEFORE UPDATE ON news_letters 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();

CREATE INDEX idx_news_letters_created_by ON news_letters(created_by);